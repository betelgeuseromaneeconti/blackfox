<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen widget's button, connected: a monochrome Victorian Gothic
  medallion with a bright white border halo and the BLACKFOX Kitsune mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- Outer silver/white halo -->
    <path
        android:fillColor="#38FFFFFF"
        android:pathData="M48,1a47,47 0,1 1,0 94a47,47 0,1 1,0 -94z" />
    <!-- Obsidian disc with monochrome gradient -->
    <path android:pathData="M48,4a44,44 0,1 1,0 88a44,44 0,1 1,0 -88z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="17"
                android:startY="8"
                android:endX="79"
                android:endY="88"
                android:startColor="#FF282830"
                android:endColor="#FF0A0A0E" />
        </aapt:attr>
    </path>
    <!-- Crisp white Victorian ring -->
    <path
        android:strokeColor="#E6FFFFFF"
        android:strokeWidth="2.2"
        android:pathData="M48,6a42,42 0,1 1,0 84a42,42 0,1 1,0 -84z" />
    <!-- Bright white Kitsune mask -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M26,20 L39,31 L48,28.5 L57,31 L70,20 L67.5,47 L60,62 L48,77 L36,62 L28.5,47 Z M48,34 L45,40.5 L48,47 L51,40.5 Z M33,46.5 L44,50 L36,52.8 Z M63,46.5 L52,50 L60,52.8 Z" />
    <!-- Connected status check badge at bottom right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M70,70m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0" />
    <path
        android:strokeColor="#FF0A0A0E"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M65,70l3.5,3.5l7,-7" />
</vector>
